{
  "name": "wing-modes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:assets": "node scripts/check-assets.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "benchmark": "npm run build && node scripts/browser-benchmark.mjs"
  },
  "engines": { "node": ">=22.12.0 <25" },
  "dependencies": { "three": "0.185.1" },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
